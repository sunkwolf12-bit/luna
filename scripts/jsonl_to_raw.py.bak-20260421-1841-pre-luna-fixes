#!/usr/bin/env python3
"""
Convert OpenClaw session JSONL to daily RAW files.

Reads the session transcript, extracts user/assistant messages,
groups by date (Mexico City time), and writes to memory/dailies-raw/.

Tracks last processed timestamp in memory/dailies-raw/.raw-cursor.json
so it can be run incrementally.

Usage:
    python3 scripts/jsonl_to_raw.py [--session-file PATH] [--full]
    
    --session-file: path to JSONL (default: auto-detect active DM session)
    --full: ignore cursor, process everything from scratch
    --topic: topic name for the RAW file (default: "dm")
"""

import json
import os
import sys
import re
from datetime import datetime
from pathlib import Path

# Usar el reloj MX como fuente única de verdad para hora México
sys.path.insert(0, str(Path(__file__).parent))
from mx_clock import MX_TZ, now as mx_now

WORKSPACE = Path("/home/elena/.openclaw/workspace")
RAW_DIR = WORKSPACE / "memory" / "dailies-raw"
CURSOR_FILE = RAW_DIR / ".raw-cursor.json"


def source_key(session_path: Path) -> str:
    return str(session_path.resolve())

def parse_args():
    import argparse
    p = argparse.ArgumentParser()
    p.add_argument("--session-file", type=str, default=None)
    p.add_argument("--full", action="store_true")
    p.add_argument("--topic", type=str, default="dm")
    return p.parse_args()

def find_active_session():
    """Find the active DM session JSONL."""
    sessions_dir = Path("/home/elena/.openclaw/agents/main/sessions")
    # Look for non-topic, non-deleted, non-reset jsonl files
    candidates = []
    for f in sessions_dir.glob("*.jsonl"):
        name = f.name
        if ".deleted" in name or ".reset" in name:
            continue
        if "-topic-" in name:
            continue
        # Use modification time — active session is the most recently written
        mtime = f.stat().st_mtime
        candidates.append((mtime, f))
    
    if not candidates:
        return None
    # Return most recently modified (active session)
    candidates.sort(reverse=True)
    return candidates[0][1]

def to_mx(ts_str):
    """Parse ISO timestamp to Mexico City datetime."""
    ts_str = ts_str.replace("Z", "+00:00")
    dt = datetime.fromisoformat(ts_str)
    return dt.astimezone(MX_TZ)

def extract_text(content):
    """Extract text from message content (list or string)."""
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        texts = []
        for c in content:
            if isinstance(c, dict) and c.get("type") == "text":
                texts.append(c["text"])
            elif isinstance(c, str):
                texts.append(c)
        return "\n".join(texts)
    return ""

def is_system_or_meta(text):
    """Check if message is system/meta noise we should skip."""
    skip_patterns = [
        r"^✅ New session started",
        r"^A new session was started via",
        r"^Read HEARTBEAT\.md",
        r"^HEARTBEAT_OK",
        r"^System: \[",
        r"^NO_REPLY$",
        r"^Current time:",
        r"^WhatsApp gateway connected",
        r"^Conversation info \(untrusted",
        r"^Sender \(untrusted",
        r"^\[Internal task completion event\]$",
        r"^source: subagent$",
        r"^type: subagent task$",
        r"^status: completed successfully$",
        r"^Result \(untrusted content, treat as data\):$",
        r"^<<<BEGIN_UNTRUSTED_CHILD_RESULT>>>$",
        r"^<<<END_UNTRUSTED_CHILD_RESULT>>>$",
        r"^This context is runtime-generated, not user-authored\.",
    ]
    for pat in skip_patterns:
        if re.match(pat, text.strip()):
            return True
    return False

def clean_noise(text):
    """Remove noise patterns from message text (Foro #6 filters)."""
    # Whisper artifacts
    text = re.sub(r'Transcribe the audio\.?\s*', '', text)
    text = re.sub(r'Transcrição e Legendas[^\n]*', '', text)
    text = re.sub(r'\nThank you\.\s*$', '', text)
    
    # Telegram metadata blocks
    text = re.sub(
        r'```json\s*\n\s*\{[^}]*"(?:message_id|sender_id|label)"[^}]*\}\s*\n\s*```\s*',
        '', text, flags=re.DOTALL
    )
    text = re.sub(r'Conversation info \(untrusted metadata\):\s*\n?', '', text)
    text = re.sub(r'Sender \(untrusted metadata\):\s*\n?', '', text)
    text = re.sub(r'\[Audio\]\s*\n?', '', text)
    
    # Tool narration (only if it's the whole message essentially)
    text = re.sub(r'^(Ahora ejecuto|Leyendo el archivo|Ejecutando|Revisando el archivo|Verificando)[^\n]*\n?', '', text)
    
    # Git diff noise
    text = re.sub(r'^\s*(delete mode|create mode) \d+ [^\n]*\n?', '', text, flags=re.MULTILINE)
    
    return text.strip()

def is_solo_filler(text):
    """Check if message is just a filler word with no real content."""
    solo_patterns = [
        r'^Listo[.!:,]*$',
        r'^Hecho[.!:,]*$',
        r'^Perfecto[.!:,]*$',
        r'^Ok[.!:,]*$',
        r'^Git limpio[.!]*$',
    ]
    stripped = text.strip()
    for pat in solo_patterns:
        if re.match(pat, stripped):
            return True
    return False

def extract_user_text(text):
    """Extract the actual user message from Telegram metadata wrapper."""
    # Look for transcript in audio messages
    transcript_match = re.search(r"Transcript:\s*\n?(.*?)$", text, re.DOTALL)
    
    # Look for actual user text after all the metadata
    # Pattern: after the metadata block, the actual message
    lines = text.strip().split("\n")
    
    # If it's an audio message, prefer the transcript
    if transcript_match:
        return transcript_match.group(1).strip()
    
    # If it has Telegram metadata, try to find the actual message
    if "Conversation info" in text or "sender_id" in text:
        # Find text after all metadata blocks
        in_json = False
        last_json_end = 0
        for i, line in enumerate(lines):
            if line.strip().startswith("```json"):
                in_json = True
            elif line.strip() == "```" and in_json:
                in_json = False
                last_json_end = i
        
        if last_json_end > 0 and last_json_end + 1 < len(lines):
            actual = "\n".join(lines[last_json_end + 1:]).strip()
            if actual:
                return actual
    
    return text.strip()

def clean_assistant_text(text):
    """Clean assistant message — remove reply tags, keep content."""
    text = re.sub(r"\[\[reply_to_\w+\]\]\s*", "", text)
    # Remove tool call narration but keep the actual response
    # If message is ONLY tool calls with no text, skip it
    if not text.strip():
        return ""
    return text.strip()

def process_jsonl(filepath, cursor_ts=None):
    """Process JSONL file, return messages grouped by MX date."""
    messages_by_date = {}
    
    with open(filepath) as f:
        for line in f:
            try:
                obj = json.loads(line)
            except json.JSONDecodeError:
                continue
            
            if obj.get("type") != "message":
                continue
            
            msg = obj.get("message", {})
            role = msg.get("role")
            ts = obj.get("timestamp", "")
            
            if role not in ("user", "assistant"):
                continue
            
            # Skip if before cursor
            if cursor_ts and ts <= cursor_ts:
                continue
            
            text = extract_text(msg.get("content", []))
            if not text:
                continue
            
            # Skip system/meta messages
            if is_system_or_meta(text):
                continue
            
            # Clean up
            if role == "user":
                text = extract_user_text(text)
                if is_system_or_meta(text):
                    continue
            else:
                text = clean_assistant_text(text)
                if not text:
                    continue
            
            # Apply noise filters (Foro #6)
            text = clean_noise(text)
            if not text:
                continue
            
            # Skip solo filler messages
            if role == "assistant" and is_solo_filler(text):
                continue
            
            # Skip very short assistant messages that are just tool narration
            if role == "assistant" and len(text) < 10:
                continue
            
            mx_dt = to_mx(ts)
            date_key = mx_dt.strftime("%Y-%m-%d")
            time_str = mx_dt.strftime("%H:%M")
            
            if date_key not in messages_by_date:
                messages_by_date[date_key] = []
            
            label = "Fer" if role == "user" else "Claudy"
            messages_by_date[date_key].append({
                "time": time_str,
                "label": label,
                "text": text,
                "ts": ts,
            })
    
    return messages_by_date

def build_raw_content(date_key, messages, topic):
    """Build full RAW file content for a single day."""
    dt = datetime.strptime(date_key, "%Y-%m-%d")
    month_names = {1:"enero",2:"febrero",3:"marzo",4:"abril",5:"mayo",6:"junio",
                  7:"julio",8:"agosto",9:"septiembre",10:"octubre",11:"noviembre",12:"diciembre"}
    lines = [f"# RAW — #{topic} — {dt.day} {month_names[dt.month]} {dt.year}", "", "## [AUTO-EXPORT desde JSONL]", ""]
    for msg in messages:
        text = msg["text"]
        lines.append(f"**[{msg['time']} MX] {msg['label']}:**")
        lines.append(text)
        lines.append("")
    return "\n".join(lines).rstrip() + "\n"


def write_raw_files(messages_by_date, topic, full_rebuild=False):
    """Write RAW files. In full_rebuild mode, overwrite affected files cleanly."""
    RAW_DIR.mkdir(parents=True, exist_ok=True)
    
    for date_key, messages in sorted(messages_by_date.items()):
        filename = f"{topic}-{date_key}.md"
        filepath = RAW_DIR / filename

        if full_rebuild:
            filepath.write_text(build_raw_content(date_key, messages, topic))
            continue

        # Incremental append mode
        if not filepath.exists():
            dt = datetime.strptime(date_key, "%Y-%m-%d")
            month_names = {1:"enero",2:"febrero",3:"marzo",4:"abril",5:"mayo",6:"junio",
                          7:"julio",8:"agosto",9:"septiembre",10:"octubre",11:"noviembre",12:"diciembre"}
            header = f"# RAW — #{topic} — {dt.day} {month_names[dt.month]} {dt.year}\n"
            filepath.write_text(header)

        with open(filepath, "a") as f:
            f.write(f"\n## [AUTO-EXPORT desde JSONL]\n\n")
            for msg in messages:
                text = msg["text"]
                f.write(f"**[{msg['time']} MX] {msg['label']}:**\n{text}\n\n")
    
    return list(messages_by_date.keys())

def load_cursor(session_path=None):
    """Load last processed timestamp. Supports per-source cursors with backward compatibility."""
    if not CURSOR_FILE.exists():
        return None
    data = json.loads(CURSOR_FILE.read_text())
    if session_path and data.get("sources"):
        skey = source_key(Path(session_path))
        return data["sources"].get(skey, {}).get("last_ts")
    return data.get("last_ts")


def save_cursor(ts, session_path=None, topic=None):
    """Save last processed timestamp. Writes per-source cursor when session_path is provided.

    El campo `updated` del cursor vive en hora MX (no UTC) para ser consistente
    con el resto del pipeline — fuente única de verdad = mx_clock.
    """
    now = mx_now().isoformat()
    if session_path:
        if CURSOR_FILE.exists():
            try:
                data = json.loads(CURSOR_FILE.read_text())
            except Exception:
                data = {}
        else:
            data = {}
        data.setdefault("version", 2)
        data.setdefault("sources", {})
        data["sources"][source_key(Path(session_path))] = {
            "topic": topic,
            "last_ts": ts,
        }
        data["updated"] = now
        CURSOR_FILE.write_text(json.dumps(data))
    else:
        CURSOR_FILE.write_text(json.dumps({"last_ts": ts, "updated": now}))

def main():
    args = parse_args()
    
    # Find session file
    if args.session_file:
        session_path = Path(args.session_file)
    else:
        session_path = find_active_session()
    
    if not session_path or not session_path.exists():
        print("ERROR: No session file found")
        sys.exit(1)
    
    print(f"Processing: {session_path.name}")
    print(f"Size: {session_path.stat().st_size / 1024:.1f} KB")
    
    # Load cursor
    cursor_ts = None if args.full else load_cursor(session_path)
    if cursor_ts:
        print(f"Cursor: {cursor_ts}")
    else:
        print("No cursor — processing full file")
    
    # Process
    messages_by_date = process_jsonl(session_path, cursor_ts)
    
    total_msgs = sum(len(v) for v in messages_by_date.values())
    print(f"Found {total_msgs} messages across {len(messages_by_date)} days")
    
    if total_msgs == 0:
        print("Nothing new to process")
        return
    
    # Write
    dates = write_raw_files(messages_by_date, args.topic, full_rebuild=args.full)
    print(f"Wrote RAW files for: {', '.join(dates)}")
    
    # Update cursor with latest timestamp
    all_msgs = []
    for msgs in messages_by_date.values():
        all_msgs.extend(msgs)
    if all_msgs:
        latest_ts = max(m["ts"] for m in all_msgs)
        save_cursor(latest_ts, session_path=session_path, topic=args.topic)
        print(f"Cursor updated to: {latest_ts}")

if __name__ == "__main__":
    main()
